{
  "openapi": "3.1.0",
  "info": {
    "title": "BookNest API",
    "description": "Учебный REST API книжного клуба BookNest",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/books": {
      "get": {
        "tags": [
          "books"
        ],
        "summary": "List Books",
        "description": "Получить каталог с фильтрами и сортировкой по нескольким полям.",
        "operationId": "list_books_api_v1_books_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Q"
            }
          },
          {
            "name": "genre",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "scifi",
                    "history",
                    "poetry",
                    "cs",
                    "fiction"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Genre"
            }
          },
          {
            "name": "available_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Available Only"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^-?(title|year|id)(,-?(title|year|id))*$",
              "default": "title",
              "title": "Sort"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_BookRead_"
                }
              }
            }
          },
          "404": {
            "description": "Запись не найдена"
          },
          "409": {
            "description": "Конфликт данных"
          },
          "422": {
            "description": "Ошибка проверки данных"
          },
          "429": {
            "description": "Слишком много запросов"
          }
        }
      },
      "post": {
        "tags": [
          "books"
        ],
        "summary": "Create Book",
        "description": "Создать книгу; ISBN должен быть уникальным.",
        "operationId": "create_book_api_v1_books_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookRead"
                }
              }
            }
          },
          "404": {
            "description": "Запись не найдена"
          },
          "409": {
            "description": "Конфликт данных"
          },
          "422": {
            "description": "Ошибка проверки данных"
          },
          "429": {
            "description": "Слишком много запросов"
          }
        }
      }
    },
