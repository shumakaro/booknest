DATABASE_URL=postgresql+psycopg://booknest:replace-password@localhost:5432/booknest
TEST_DATABASE_URL=postgresql+psycopg://booknest:replace-password@localhost:5432/booknest_test
SQL_ECHO=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
WRITE_LIMIT=60
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
VITE_API_TARGET=http://localhost:8000
VITE_API_BASE_URL=/api/v1
VITE_PORT=5173
PLAYWRIGHT_BASE_URL=http://localhost:5173
PLAYWRIGHT_CHANNEL=
POSTGRES_DB=booknest
POSTGRES_USER=booknest
POSTGRES_PASSWORD=replace-with-random-url-safe-password
WEB_BIND=127.0.0.1
WEB_PORT=8080
DOCKER_SUBNET=172.29.241.0/24
WEB_INTERNAL_IP=172.29.241.10

